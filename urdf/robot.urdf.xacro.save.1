<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- ==================== COLORES Y MATERIALES ==================== -->
  <material name="blue">
    <color rgba="0.0 0.2 0.8 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <!-- ==================== MACROS INERCIALES ==================== -->
  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${(1/12) * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * mass * (x*x + z*z)}" iyz="0.0"
               izz="${(1/12) * mass * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0.0"
               izz="${(1/2) * mass * (radius*radius)}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== BASE LINK ==================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.2" length="0.1"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.2" length="0.1"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="5.0" length="0.1" radius="0.2">
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <!-- ==================== JOINT 1 (Revolución) ==================== -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.3"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.3"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="2.0" length="0.3" radius="0.08">
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <!-- ==================== JOINT 2 (Revolución) ==================== -->
  <joint name="joint_2" type="revolute">
    <parent link="shoulder_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="arm_link">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.4"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.4"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="1.5" x="0.08" y="0.08" z="0.4">
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- ==================== JOINT 3 (Prismático) ==================== -->
  <joint name="joint_3" type="prismatic">
    <parent link="arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.2" effort="10.0" velocity="0.5"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.3"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.3"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="1.0" length="0.3" radius="0.05">
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <!-- ==================== JOINT 4 (Continuo) ==================== -->
  <joint name="joint_4" type="continuous">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.04 0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.04 0.05"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.5" x="0.12" y="0.04" z="0.05">
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- ==================== EFECTOR FINAL / GRIPPER ==================== -->
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="wrist_link"/>
    <child link="gripper_left_link"/>
    <origin xyz="-0.04 0 0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.03" effort="5.0" velocity="0.2"/>
  </joint>

  <link name="gripper_left_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.03 0.08"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.03 0.08"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.1" x="0.015" y="0.03" z="0.08">
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="gripper_right_joint" type="prismatic">
    <parent link="wrist_link"/>
    <child link="gripper_right_link"/>
    <origin xyz="0.04 0 0.05" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0.0" upper="0.03" effort="5.0" velocity="0.2"/>
  </joint>

  <link name="gripper_right_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.03 0.08"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.03 0.08"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.1" x="0.015" y="0.03" z="0.08">
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

</robot>


